NODE_ENV=development
PORT=5000

# PostgreSQL connection string. With the docker-compose file in the repo root this works as is.
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker
# Set to true for hosted databases that require SSL (Neon, Supabase, Render, ...)
DATABASE_SSL=false

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

CLIENT_ORIGIN=http://localhost:3000
# Comma separate for more than one origin. For cross-site deployments use COOKIE_SAMESITE=none (needs HTTPS)
COOKIE_SAMESITE=lax

BCRYPT_ROUNDS=10
DUE_SOON_HOURS=24
ENABLE_CRON=true
