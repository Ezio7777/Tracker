{
  "name": "tracker-server",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:setup": "node src/db/setup.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/seed/seed.js",
    "test": "jest --runInBand",
    "postman": "node postman/generate.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ],
    "testTimeout": 30000
  },
  "description": "Task and ticket tracker API (Express, PostgreSQL, Socket.IO)"
}
