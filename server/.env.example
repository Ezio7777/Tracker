NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tracker
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
CLIENT_ORIGIN=http://localhost:3000
# comma-separate multiple origins. For cross-site deploys use COOKIE_SAMESITE=none (needs HTTPS)
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=10
DUE_SOON_HOURS=24
ENABLE_CRON=true
